# ── Cloudflare R2 ────────────────────────────────────────────────────────
# Account ID   : HANYA 32 karakter hex, BUKAN URL endpoint lengkap.
#                Salah: https://4a27...770f.r2.cloudflarestorage.com/juicefs
#                Benar: 4a27...770f
#                (compose merakit URL endpoint-nya sendiri)
# Access Key   : Dashboard → R2 → Manage R2 API Tokens
#                → Create Account API token
#                → Permission "Object Read & Write", scope ke bucket ini saja
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=

# Opsional: jurisdiction "eu" atau "fedramp". Kosongkan untuk default.
# Endpoint jadi https://<ACCOUNT_ID>.<JURISDICTION>.r2.cloudflarestorage.com
R2_JURISDICTION=

# Ukuran cache baca lokal dalam MiB. Naikkan kalau dataset sering dibaca ulang —
# ini knob paling berpengaruh ke performa (cold read ~8 MB/s vs cache ~350 MB/s).
CACHE_SIZE=10240

# ── WebDAV (akses dari Finder macOS lewat ⌘K) ───────────────────────────
WEBDAV_USER=jfs
WEBDAV_PASSWORD=jfs

# ── SMB (mount native di Finder macOS: smb://localhost/jfs) ─────────────
SMB_USER=jfs
SMB_PASSWORD=juicefs123

# ── Saklar layanan ──────────────────────────────────────────────────────
# SMB = jalur utama Finder. WebDAV cadangan, hidupkan kalau SMB bermasalah.
ENABLE_SMB=true
ENABLE_WEBDAV=false

# ── Trash ───────────────────────────────────────────────────────────────
# Berapa hari file terhapus disimpan sebelum dibersihkan permanen.
# Berlaku untuk SEMUA jalur hapus (Finder/SMB, terminal, aplikasi apa pun).
# Nilai di sini selalu diterapkan, termasuk ke volume yang sudah ada.
# 0 = trash MATI, file hilang permanen — tidak disarankan.
# Catatan: file di trash TETAP memakan storage R2 selama masa simpan.
TRASH_DAYS=1

# ── Backup saat container berhenti ──────────────────────────────────────
# Dump metadata ke folder dumps/ setiap `compose down`/`stop`. Menutup
# jendela antara backup otomatis terakhir (tiap BACKUP_META) dan saat mati.
BACKUP_ON_STOP=true
KEEP_SHUTDOWN_DUMPS=5

# ── Lanjutan (opsional) ─────────────────────────────────────────────────
# Selama ini bisa dipakai tapi tidak tercantum di template. Biarkan kosong
# kalau tidak perlu — nilai default di bawah ini yang dipakai.
BACKUP_META=1h                       # interval backup metadata ke R2; 0 = mati
META_URL=redis://redis:6379/2        # metadata engine
VOL_NAME=myjfs-r2                    # nama volume JuiceFS
WEBDAV_ADDR=0.0.0.0:9007             # alamat listen WebDAV
